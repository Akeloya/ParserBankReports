<UserControl
    x:Class="ParserApp.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:cnv="clr-namespace:ParserApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ParserApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:ParserApp.Properties"
    d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    PreviewKeyDown="View_OnPreviewKeyDown"
    PreviewMouseDown="CategoryMappings_OnPreviewMouseDown"
    PreviewMouseUp="CategoryMappings_OnPreviewMouseUp"
    mc:Ignorable="d">
    <UserControl.Resources>
        <cnv:NumberSignConverter x:Key="SignConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="{x:Static res:Resources.MenuItemFile}">
                <MenuItem cm:Message.Attach="OpenHtmlFileAsync" Header="{x:Static res:Resources.MenuItemOpenHtmlFile}" />
                <MenuItem Header="Последние отчёты" ItemsSource="{Binding RecentReports}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <EventSetter Event="Click" Handler="RecentReport_OnClick" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem cm:Message.Attach="OpenProjectAsync" Header="Открыть проект…" />
                <MenuItem cm:Message.Attach="SaveProjectAsync" Header="Сохранить проект…" />
                <MenuItem Header="Последние проекты обработки" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <EventSetter Event="Click" Handler="RecentProject_OnClick" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem cm:Message.Attach="OpenCsvFileAsync" Header="{x:Static res:Resources.MenuItemOpenCsvFile}" />
                <MenuItem cm:Message.Attach="PrintAsync" Header="Печать" />
                <MenuItem cm:Message.Attach="SaveAsync" Header="{x:Static res:Resources.MenuItemSave}" />
                <Separator />
                <MenuItem cm:Message.Attach="CloseAsync" Header="{x:Static res:Resources.MenuItemClose}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.MenuItemSettings}">
                <MenuItem cm:Message.Attach="OpenSettingsAsync" Header="{x:Static res:Resources.MenuItemImportSettings}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.MenuItemHelpRoot}">
                <MenuItem cm:Message.Attach="HelpAsync" Header="{x:Static res:Resources.MenuItemHelp}" />
                <MenuItem cm:Message.Attach="AboutAsync" Header="{x:Static res:Resources.MenuItemAbout}" />
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock
                    Margin="0,0,0,4"
                    Text="{Binding IncomeSummary}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,8"
                    Text="{Binding ExpenseSummary}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="11"
                    Text="F3 — перейти к соответствию."
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="11"
                    Text="F6 — очистить все временные категории."
                    TextWrapping="Wrap" />
                <WrapPanel>
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Кодировка CSV при сохранении:" />
                    <ComboBox
                        Width="140"
                        ItemsSource="{Binding ExportEncodings}"
                        SelectedItem="{Binding SelectedExportEncoding, Mode=TwoWay}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="Соответствие категорий файла и 1С" />
                <DockPanel Margin="0,0,0,5">
                    <Button
                        Width="28"
                        Margin="5,0,0,0"
                        cm:Message.Attach="AddCategoryScheme"
                        Content="+"
                        DockPanel.Dock="Right"
                        ToolTip="Добавить схему" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding CategorySchemes}"
                        SelectedItem="{Binding SelectedCategoryScheme, Mode=TwoWay}" />
                </DockPanel>
                <DataGrid
                    x:Name="CategoryMappingsGrid"
                    Height="150"
                    AutoGenerateColumns="False"
                    CanUserAddRows="True"
                    CanUserDeleteRows="True"
                    CanUserSortColumns="True"
                    ItemsSource="{Binding ProjectMappings}"
                    IsSynchronizedWithCurrentItem="False"
                    SelectionChanged="CategoryMappings_OnSelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedCategoryMapping, Mode=OneWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="34"
                            CanUserResize="False"
                            Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="16"
                                        Height="16"
                                        Padding="0"
                                        BorderThickness="0"
                                        Click="DeleteCategoryMapping_OnClick"
                                        Content="-"
                                        Focusable="False"
                                        ToolTip="Удалить соответствие">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNewItem, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                            Header="Категория файла" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding TitleContains, UpdateSourceTrigger=PropertyChanged}"
                            Header="Название содержит" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                            Header="Категория 1С" />
                    </DataGrid.Columns>
                </DataGrid>
                <CheckBox Content="Показать исходные категории" IsChecked="{Binding ShowOriginalCategories}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="Firebrick"
                    Text="{Binding SchemeError}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <DataGrid
            x:Name="OperationsGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{Binding VisibleOperations}"
            PreviewKeyDown="Operations_OnPreviewKeyDown"
            PreviewMouseLeftButtonDown="Operations_OnLeftButtonDown"
            PreviewMouseRightButtonDown="Operations_OnRightButtonDown">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn CanUserSort="False" />
                <DataGridTextColumn Binding="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Header="Дата" />
                <DataGridTextColumn Binding="{Binding Date, StringFormat='{}{0:dd.MM.yyyyHH:mm}'}" Header="Дата для 1C" />
                <DataGridTextColumn
                    Binding="{Binding DisplayCategory}"
                    Header="Категория"
                    IsReadOnly="True">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCategoryMapped}" Value="True">
                                    <Setter Property="Background" Value="#FFFFE082" />
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasTemporaryCategory}" Value="True">
                                    <Setter Property="Background" Value="#FFE1BEE7" />
                                    <Setter Property="Foreground" Value="#FF4A148C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Title}" Header="Название" />
                <DataGridTextColumn Binding="{Binding Summ}" Header="Сумма" />
                <DataGridTextColumn Binding="{Binding BalanceAfter}" Header="Остаток" />
                <DataGridTextColumn Binding="{Binding Location}" Header="Место" />
                <DataGridTextColumn Binding="{Binding ProcessDate, StringFormat='{}{0:dd.MM.yyyy}'}" Header="Проведено" />
                <DataGridTextColumn Binding="{Binding CardName}" Header="Карта" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Summ, Converter={StaticResource SignConverter}}" Value="-1">
                            <Setter Property="Background" Value="LightPink" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Summ, Converter={StaticResource SignConverter}}" Value="1">
                            <Setter Property="Background" Value="LightGreen" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
